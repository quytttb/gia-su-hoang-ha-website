{
  "name": "gia-su-hoang-ha-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:vercel": "npm run build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "preview": "next start",
    "start": "next start",
    "prepare": "node -e \"if (process.env.CI || process.env.VERCEL) process.exit(0)\" || husky install",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest --coverage",
    "test:seo": "./scripts/test-seo.sh",
    "test:seo:prod": "./scripts/test-seo.sh https://giasuhoangha.com",
    "deploy": "./scripts/deploy.sh",
    "deploy:prod": "./scripts/deploy-production.sh",
    "deploy:quick": "./scripts/deploy-quick.sh",
    "deploy:quick:prod": "./scripts/deploy-production-quick.sh",
    "env:sync:preview": "./scripts/sync-vercel-preview-env.sh",
    "env:sync:prod": "./scripts/sync-vercel-production-env.sh",
    "seed:supabase": "node scripts/seed-supabase-api.mjs",
    "migrate:images": "node scripts/migrate-images-to-supabase.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
