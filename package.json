    "nuqs": "^2.9.0",
    "prisma": "^6.19.3",
    "react": "^18.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18.2.0",
    "react-easy-crop": "^5.4.2",
    "react-hook-form": "^7.80.0",
    "slugify": "^1.6.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.0",
    "web-vitals": "^5.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
