rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isStaff() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'staff'];
    }

    // Public read for classes
    match /classes/{classId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Public read for schedules
    match /schedules/{scheduleId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Public read for tutors
    match /tutors/{tutorId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Anyone can create registrations
    match /registrations/{registrationId} {
      allow read: if isStaff();
      allow create: if true;
      allow update, delete: if isStaff();
    }

    // Anyone can create contact messages; staff can manage
    match /contacts/{contactId} {
      allow read, update, delete: if isStaff();
      allow create: if true;
    }

    // Published blog posts are public
    match /blogPosts/{postId} {
      allow read: if resource.data.status == 'published' || isStaff();
      allow write: if isStaff();
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
